#!/usr/bin/env bash
# Bash script that audits domain subdomains using dig and awk
# shellcheck disable=SC2086

audit_subdomain() {
    local sub=$1
    local dom=$2
    dig "$sub.$dom" A +noall +answer | awk -v s="$sub" '{print "The subdomain " s " is a " $4 " record and points to " $5}'
}

DOMAIN=$1
SUBDOMAIN=$2

if [ -n "$SUBDOMAIN" ]; then
    audit_subdomain "$SUBDOMAIN" "$DOMAIN"
else
    for sub in www lb-01 web-01 web-02; do
        audit_subdomain "$sub" "$DOMAIN"
    done
fi
